DATABASE_PATH=./data/fuckcancer.db

JWT_SECRET=
ENCRYPTION_KEY=

# Google OAuth — used for app sign-in (identity) only. No Drive scope is
# requested; storage lives in NotebookLM. Enable the "Google People API" /
# userinfo scopes when creating the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Only this Google account may use this self-hosted installation.
OWNER_EMAIL=

# Dedicated, gitignored NotebookLM cookie jar created with:
# npx --package=@cola_runner/gemini-notebook-cli@0.2.1 gemini-notebook login --paste --storage "$PWD/notebooklm-session/storage_state.json"
NOTEBOOKLM_STORAGE_PATH=./notebooklm-session/storage_state.json

APP_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
