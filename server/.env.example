DATABASE_PATH=./data/fuckcancer.db

JWT_SECRET=
ENCRYPTION_KEY=

# Google OAuth — used for app sign-in (identity) only. No Drive scope is
# requested; storage lives in NotebookLM. Enable the "Google People API" /
# userinfo scopes when creating the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# NotebookLM session (cookie jar). Optional — defaults to the CLI location
# ~/.config/notebooklm-cli/storage_state.json created by `notebooklm login`.
# NOTEBOOKLM_STORAGE_PATH=

APP_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
